# Deployer authentication: set ONE of these
MNEMONIC=
PRIVATE_KEY=

# RPC endpoints (public defaults are used when unset)
RPC_URL_BSC=
RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
RPC_URL_BSC_TESTNET=
RPC_URL_ROBINHOOD_TESTNET=https://rpc.testnet.chain.robinhood.com

# Optional: existing PULT test token on BSC testnet. Leave empty to deploy CatapultTrade there.
PULT_TOKEN_BSC_TESTNET=

# Contract verification
BSCSCAN_API_KEY=
